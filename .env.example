# AI_Motion_PoC must remain independent from Badminton Plus One production.
POC_RESOURCE_ISOLATION=true
AI_MOTION_BILLING_MODE=free
APP_ENV=development
REQUIRE_PUBLIC_AUTH=false

DATABASE_URL=postgresql://username:password@localhost:5432/ai_motion_poc
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Leave cloud resources blank for local experiments. Future deployment must use
# dedicated PoC names, never the Badminton Plus One database, bucket, or queue.
VIDEO_UPLOAD_BUCKET=
KEYFRAME_ASSET_BUCKET=
AI_MOTION_SERVICE_ACCOUNT=
GOOGLE_CLOUD_PROJECT=
AI_MOTION_TASK_LOCATION=asia-east1
AI_MOTION_TASK_QUEUE=
AI_MOTION_WORKER_URL=
AI_MOTION_TASK_AUDIENCE=
INTERNAL_API_KEY=
APP_JWT_SECRET=
